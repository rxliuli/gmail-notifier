{
  "name": "gmail-notifier",
  "description": "Gmail Notifier for Browser",
  "private": true,
  "version": "0.5.11",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:safari": "wxt zip -b safari",
    "reload:safari": "bash scripts/reload-safari.sh",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:browser": "vitest"
  },
  "dependencies": {
    "@extport/sdk": "^0.0.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@webext-core/messaging": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-select": "^7.0.0",
    "dayjs": "^1.11.23",
    "entities": "^9.0.0",
    "es-toolkit": "^1.53.2",
    "lucide-react": "^1.73.0",
    "parse5": "^8.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-shadow": "^20.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
