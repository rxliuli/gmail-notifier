    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "htmlparser2": "^12.0.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0",
    "wxt": "^0.21.5"
